{
  "name": "medigraph",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "build": "astro build",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:shell": "shellcheck .husky/pre-commit .husky/pre-push",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run",
    "verify:static": "pnpm lint && pnpm format:check && pnpm typecheck"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,astro}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,jsonc,md,yml,yaml,html}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{sh,bash}": [
      "prettier --write",
      "shellcheck"
    ],
    "{Dockerfile,Dockerfile.*,*.dockerfile}": [
      "prettier --write",
      "hadolint"
    ],
    ".husky/*": [
      "prettier --parser sh --write",
      "shellcheck"
    ]
  },
  "dependencies": {
    "@astrojs/preact": "4.1.3",
    "astro": "5.18.2",
    "preact": "10.29.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.0.1",
    "@eslint/markdown": "8.0.3",
    "@html-eslint/eslint-plugin": "0.65.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.1.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-yml": "3.8.1",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-sh": "0.19.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
