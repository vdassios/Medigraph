---
import { MedigraphApp } from '../ui/MedigraphApp';

// The one hydrated route (D2). Everything visible here is inside the island,
// including the standing D1/D13 notice, because all of it follows the language
// toggle the island owns.
---

<html lang="el">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Medigraph</title>
  </head>
  <body>
    <MedigraphApp client:load />
  </body>
</html>

<style>
  .app-disclaimer {
    border-top: 1px solid currentColor;
    font-size: 0.8125rem;
    line-height: 1.5;
    margin: 2rem auto 0;
    max-width: 40rem;
    padding: 1rem;
  }
</style>
