---
import { COPY, LANGUAGES } from '../ui/i18n';

// Zero-hydration landing route (D2): no island, no client script. Both
// languages are rendered rather than toggled, because a toggle needs
// JavaScript and this page ships none — each block carries its own `lang`, so
// a screen reader announces each in the right voice.
---

<html lang="el">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Medigraph</title>
  </head>
  <body>
    <main class="landing">
      <h1>Medigraph</h1>

      {
        LANGUAGES.map((language) => (
          <section lang={language} class="landing-block">
            <p class="tagline">{COPY[language].landing.tagline}</p>
            <p>{COPY[language].landing.what}</p>
            <p>
              <a href="/app/">{COPY[language].landing.open}</a> ·{' '}
              <a href="/privacy/">{COPY[language].landing.privacy}</a>
            </p>

            <div class="disclaimer">
              <p>{COPY[language].disclaimer.dataStays}</p>
              <p>{COPY[language].disclaimer.plaintext}</p>
              <p>{COPY[language].disclaimer.displayOnly}</p>
            </div>
          </section>
        ))
      }
    </main>
  </body>
</html>

<style>
  .landing {
    margin: 0 auto;
    max-width: 40rem;
    padding: 2rem 1rem;
  }

  .landing-block + .landing-block {
    border-top: 1px solid currentColor;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
  }

  .tagline {
    font-size: 1.25rem;
  }

  .disclaimer {
    font-size: 0.875rem;
    line-height: 1.5;
  }
</style>
